# Copy to .env (chmod 600) and fill in. Never commit .env.
# The deploy workflow writes this file on the server from GitHub repository variables and secrets.

# Your public hostname, e.g. riri.example.duckdns.org (ports 80 and 443 forwarded to this machine)
DOMAIN=
# The Linux account RiRi works as on the server (the one that owns ~/reliquary)
HOST_USER=
TZ=Asia/Kolkata

# The model file in ~/llm/models, and how to run it
MODEL=gpt-oss-20b-Q4_K_M.gguf
CTX=32768
THREADS=4
CACHE_RAM=1024

# Long random string shared by the app and its sandbox: openssl rand -hex 32
WORKBENCH_TOKEN=

# Optional: reuse an existing Caddy data volume (keeps an already-issued certificate)
# CADDY_DATA_VOLUME=riri_caddy_data
